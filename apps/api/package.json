{
  "name": "@break-bread/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "migrate:create": "node-pg-migrate create --migration-file-language sql"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.8",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
