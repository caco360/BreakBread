# Copy this file to .env and fill in the secrets. Never commit .env.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Optional in development: these default to the Docker Compose services.
# DATABASE_URL=postgres://breakbread:breakbread@localhost:5432/break_bread
# REDIS_URL=redis://localhost:6379

# Required. At least 32 characters. Signs login tokens.
JWT_SECRET=replace-me

# Required. At least 32 characters. Protects stored login codes.
LOGIN_CODE_SECRET=replace-me
